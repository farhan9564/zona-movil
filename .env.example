# Leave DATABASE_URL empty for the read-only storefront/admin demo.
DATABASE_URL=
# Postgres pooler URL with sslmode=require (Neon or Supabase)
ADMIN_EMAIL=owner@example.com
# Generate with npm run admin:hash -- 'your-long-unique-password'
ADMIN_PASSWORD_HASH=
# Generate each separately: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SETTINGS_ENCRYPTION_KEY=
# Set exact deployed origin, no trailing slash; localhost for development
APP_URL=http://localhost:3000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
